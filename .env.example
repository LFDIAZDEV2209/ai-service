ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# â”€â”€ LLM (multi-proveedor) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Proveedor por defecto: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (chat + embeddings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# â”€â”€ Agente â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
MAX_TOOL_CALLS=8
RECURSION_LIMIT=25
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# â”€â”€ Seguridad â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
MAX_INPUT_LENGTH=8000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Clave compartida con el backend (.NET) para los endpoints internos
# (X-Internal-Key). Obligatoria en producciÃ³n; sin ella los endpoints
# internos responden 503.
INTERNAL_API_KEY=

# OrÃ­genes permitidos por CORS (separados por coma). El AI Service no tiene
# clientes de navegador hoy (lo consume el backend server-to-server); ajustar
# por entorno.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# â”€â”€ Memoria â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# OBLIGATORIA: URL de conexiÃ³n a PostgreSQL (misma base del backend, schema ai).
# No existe valor por defecto; sin ella la aplicaciÃ³n no arranca.
# Ej: postgresql://usuario:password@localhost:5432/coppaddresd
DATABASE_URL=
MEMORY_STORE_PATH=./data/memory.json

# â”€â”€ RAG â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DOCS_PATH=./docs
RAG_TOP_K=5
