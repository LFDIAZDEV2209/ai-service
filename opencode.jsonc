{
  // ai-service (LangGraph + FastAPI, uv) — project config autocontenido.
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "../AGENTS.md",
    "../LEARNINGS.md",
    "../.agents/rules/*.md",
  ],
  "skills": ["./.agents/skills", "../.agents/skills"],
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "uv sync*", "effect": "allow" },
    { "action": "shell", "resource": "uv run pytest*", "effect": "allow" },
    { "action": "shell", "resource": "uv run ruff*", "effect": "allow" },
    { "action": "shell", "resource": "uv run python run_dev.py*", "effect": "allow" },
    { "action": "shell", "resource": "uv run alembic*", "effect": "allow" },
  ],
  "agents": {
    "coppaddresd": {
      "description": "Agente principal ai-service: LangGraph + FastAPI, skills-first",
      "mode": "primary",
      "system": "Eres el agente principal del ai-service (Python 3.11+, LangGraph, FastAPI, uv, puerto 8000). Aplica .agents/rules/*.md: carga fastapi-python + pydantic (+ python-testing-patterns / machine-learning según toque) con skill() ANTES de codificar; dev solo con uv run python run_dev.py (nunca uvicorn directo); checkpointer async solo vía get_graph/deps; memory_save commitea; respeta schema ai. + Alembic; verifica con uv run ruff check . + pytest enfocado. Responde en el idioma del usuario; docs en español.",
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "allow" },
      ],
    },
    "design-expert": {
      "description": "Diseñador UX/UI senior para piezas visibles (docs, playground, monitoreo)",
      "mode": "subagent",
      "system": "Diseñador UX/UI senior. Carga design-taste-frontend + impeccable antes de codificar. Bans anti-slop, WCAG 2.2 AA, estados loading/empty/error.",
    },
    "reviewer": {
      "description": "Revisor Python/FastAPI sin editar",
      "mode": "subagent",
      "system": "Revisor Python senior. Analiza sin editar: async correcto, checkpointer/commit de memoria, aislamiento RAG por agente, contratos snake_case, tests sin API keys. Cita archivo:línea.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
      ],
    },
  },
  "experimental": {
    "subagent_depth": 2,
  },
  "compaction": {
    "auto": true,
    "buffer": 15000,
  },
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"],
    },
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
      },
    },
  },
  "formatter": {
    "ruff": {
      "command": ["ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"],
    },
  },
}
